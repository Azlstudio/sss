<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GTASALauncher.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1E1E1E"
    Foreground="#FFFFFF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Title -->
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Margin="0,0,0,20"
                Text="Graphics Settings" />

            <!-- Graphics Section -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00FF00"
                        Margin="0,0,0,15"
                        Text="Display" />

                    <!-- Resolution -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Margin="0,0,0,5"
                            Text="Resolution" />
                        <ComboBox
                            x:Name="ResolutionCombo"
                            Padding="10"
                            Background="#1E1E1E"
                            Foreground="#FFFFFF"
                            BorderBrush="#3E3E42"
                            FontSize="12">
                            <ComboBoxItem>1920x1080 (Default)</ComboBoxItem>
                            <ComboBoxItem>1680x1050</ComboBoxItem>
                            <ComboBoxItem>1600x900</ComboBoxItem>
                            <ComboBoxItem>1440x900</ComboBoxItem>
                            <ComboBoxItem>1366x768</ComboBoxItem>
                            <ComboBoxItem>1280x720</ComboBoxItem>
                            <ComboBoxItem>1024x768</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Fullscreen -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="FullscreenCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#CCCCCC"
                            FontSize="12"
                            Text="Fullscreen" />
                    </StackPanel>

                    <!-- VSync -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="VSyncCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#CCCCCC"
                            FontSize="12"
                            Text="VSync" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quality Section -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00FF00"
                        Margin="0,0,0,15"
                        Text="Quality" />

                    <!-- Blur -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="BlurCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Motion Blur" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="Disable for performance" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Shadows -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="ShadowsCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Dynamic Shadows" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="Realistic shadows" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Reflections -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="ReflectionsCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Reflections" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="Water and surface reflections" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Particles -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="ParticlesCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Particles" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="Explosions, smoke, effects" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Distance Fog -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="FogCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Distance Fog" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="Fog effect at distance" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Performance Section -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00FF00"
                        Margin="0,0,0,15"
                        Text="Performance" />

                    <!-- Draw Distance -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Margin="0,0,0,5"
                            Text="View Distance" />
                        <Slider
                            x:Name="DrawDistanceSlider"
                            Minimum="500"
                            Maximum="3000"
                            Value="2000"
                            Background="#1E1E1E"
                            Foreground="#007ACC" />
                        <TextBlock
                            x:Name="DrawDistanceLabel"
                            FontSize="10"
                            Foreground="#888888"
                            Text="2000 meters" />
                    </StackPanel>

                    <!-- LOD Distance -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Margin="0,0,0,5"
                            Text="LOD Distance" />
                        <Slider
                            x:Name="LODSlider"
                            Minimum="50"
                            Maximum="500"
                            Value="300"
                            Background="#1E1E1E"
                            Foreground="#007ACC" />
                        <TextBlock
                            x:Name="LODLabel"
                            FontSize="10"
                            Foreground="#888888"
                            Text="300 units" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Advanced Section -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00FF00"
                        Margin="0,0,0,15"
                        Text="Advanced" />

                    <!-- Anti-Aliasing -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Margin="0,0,0,5"
                            Text="Anti-Aliasing" />
                        <ComboBox
                            x:Name="AACombo"
                            Padding="10"
                            Background="#1E1E1E"
                            Foreground="#FFFFFF"
                            BorderBrush="#3E3E42"
                            FontSize="12">
                            <ComboBoxItem>Disabled</ComboBoxItem>
                            <ComboBoxItem>2x MSAA</ComboBoxItem>
                            <ComboBoxItem>4x MSAA</ComboBoxItem>
                            <ComboBoxItem>8x MSAA</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Texture Quality -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Margin="0,0,0,5"
                            Text="Texture Quality" />
                        <ComboBox
                            x:Name="TextureCombo"
                            Padding="10"
                            Background="#1E1E1E"
                            Foreground="#FFFFFF"
                            BorderBrush="#3E3E42"
                            FontSize="12">
                            <ComboBoxItem>Low</ComboBoxItem>
                            <ComboBoxItem>Medium</ComboBoxItem>
                            <ComboBoxItem>High</ComboBoxItem>
                            <ComboBoxItem>Ultra</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Anisotropic Filtering -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="AFCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="Anisotropic Filtering" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="16x AF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- HDR -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <CheckBox
                            x:Name="HDRCheck"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            IsChecked="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="#CCCCCC"
                                FontSize="12"
                                Text="HDR Rendering" />
                            <TextBlock
                                Foreground="#888888"
                                FontSize="10"
                                Text="High Dynamic Range" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Preset Buttons -->
            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#00FF00"
                        Margin="0,0,0,15"
                        Text="Presets" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="12,8"
                            Background="#FF6B6B"
                            Content="Low Performance"
                            Click="ApplyLowPreset" />

                        <Button
                            Grid.Column="2"
                            Padding="12,8"
                            Background="#FFA500"
                            Content="Medium"
                            Click="ApplyMediumPreset" />

                        <Button
                            Grid.Column="4"
                            Padding="12,8"
                            Background="#00AA00"
                            Content="Ultra High"
                            Click="ApplyHighPreset" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border
                Padding="20"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Padding="15,10"
                        Background="#007ACC"
                        Content="Apply Changes"
                        Click="ApplySettings" />

                    <Button
                        Grid.Column="2"
                        Padding="15,10"
                        Background="#2D2D30"
                        Content="Reset to Default"
                        Click="ResetSettings" />
                </Grid>
            </Border>

            <!-- Status Message -->
            <TextBlock
                x:Name="StatusMessage"
                Margin="0,20,0,0"
                Foreground="#00FF00"
                FontSize="11"
                TextAlignment="Center"
                Text="Settings will be applied next time you join a server" />
        </StackPanel>
    </ScrollViewer>
</Page>
