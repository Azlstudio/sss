<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GTASALauncher.MainWindowIntegrated"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GTA San Andreas Multiplayer Launcher"
    Width="1600"
    Height="900"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Closing="Window_Closing">

    <Grid>
        <!-- Left Sidebar -->
        <StackPanel Width="280" Background="#252526" VerticalAlignment="Stretch">
            <!-- Logo -->
            <TextBlock
                Margin="20,30,20,20"
                FontSize="20"
                FontWeight="Bold"
                Text="SA MULTIPLAYER" />

            <!-- Status Info -->
            <Border
                Margin="15"
                Padding="15"
                Background="#1E1E1E"
                BorderBrush="#007ACC"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        Foreground="#00FF00"
                        FontSize="12"
                        Text="Estado:" />
                    <TextBlock
                        x:Name="TxtGameStatus"
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="#FFFF00"
                        Text="Iniciando..." />

                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#888888"
                        FontSize="10"
                        Text="Servidor:" />
                    <TextBlock
                        x:Name="TxtServerInfo"
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="#FFFFFF"
                        Text="No conectado" />
                </StackPanel>
            </Border>

            <!-- Navigation -->
            <Separator Margin="15,20" Background="#3E3E42" />

            <Button
                x:Name="BtnHome"
                Margin="10,10,10,0"
                Padding="15,10"
                Background="#007ACC"
                Content="🏠 Home"
                Click="BtnHome_Click" />

            <Button
                x:Name="BtnServers"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="🔍 Servidores"
                Click="BtnServers_Click" />

            <Button
                x:Name="BtnFavorites"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="⭐ Favoritos"
                Click="BtnFavorites_Click" />

            <Separator Margin="15,20" Background="#3E3E42" />

            <Button
                x:Name="BtnSettings"
                Margin="10,10,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="⚙️ Configuración"
                Click="BtnSettings_Click" />

            <!-- Control Buttons -->
            <StackPanel Margin="10,30,10,10" VerticalAlignment="Bottom">
                <Button
                    Padding="15,10"
                    Background="#FF6B6B"
                    Content="❌ Salir del Juego"
                    Click="BtnExitGame_Click" />

                <Button
                    Margin="0,10,0,0"
                    Padding="15,10"
                    Background="#2D2D30"
                    Content="⚠️ Reportar"
                    Click="BtnReport_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Margin="280,0,0,0">
            <!-- Split View: Sidebar + Game -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Right Sidebar: Server Info & Chat -->
                <StackPanel Grid.Column="0" Background="#252526" Margin="0,0,1,0" BorderBrush="#3E3E42" BorderThickness="1,0,1,0">
                    <TextBlock
                        Margin="15,15,15,10"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="📊 Servidor" />

                    <Border
                        Margin="15,0,15,15"
                        Padding="10"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#00FF00"
                                x:Name="TxtServerName"
                                Text="SA-RP Server" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#888888"
                                        Text="Jugadores" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#FFFF00"
                                        x:Name="TxtPlayerCount"
                                        Text="78/100" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#888888"
                                        Text="Ping" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#00FF00"
                                        x:Name="TxtPing"
                                        Text="45ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Chat -->
                    <TextBlock
                        Margin="15,10,15,5"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="💬 Chat" />

                    <ListBox
                        x:Name="ChatBox"
                        Margin="15,0,15,10"
                        Height="200"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        Foreground="#FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8" />

                    <!-- Chat Input -->
                    <Grid Margin="15,0,15,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Padding="8"
                            Background="#1E1E1E"
                            Foreground="#FFFFFF"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            x:Name="TxtChatInput"
                            PlaceholderText="Escribe un mensaje..."
                            KeyDown="TxtChatInput_KeyDown" />

                        <Button
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Background="#007ACC"
                            Content="➤"
                            Click="BtnSendChat_Click" />
                    </Grid>

                    <!-- Players List -->
                    <TextBlock
                        Margin="15,10,15,5"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="👥 Jugadores" />

                    <ListBox
                        x:Name="PlayersList"
                        Margin="15,0,15,15"
                        Height="200"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        Foreground="#FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8" />
                </StackPanel>

                <!-- Game Window Area -->
                <Grid Grid.Column="1">
                    <!-- Status bar -->
                    <StackPanel VerticalAlignment="Top" Height="40" Background="#252526" Orientation="Horizontal" Padding="15">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#FFFFFF"
                            FontSize="12"
                            x:Name="TxtGameInfo"
                            Text="GTA San Andreas en ejecución..." />

                        <TextBlock
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Foreground="#666666"
                            FontSize="10"
                            Text="F1 para UI | ESC para opciones" />
                    </StackPanel>

                    <!-- Game Window Container -->
                    <WindowsFormsHost
                        x:Name="GameContainer"
                        Margin="0,40,0,0"
                        Background="#000000" />
                </Grid>
            </Grid>

            <!-- Overlay when no server connected -->
            <Border
                x:Name="NoServerOverlay"
                Background="#000000AA"
                Visibility="Visible">
                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="Selecciona un Servidor para Jugar" />

                    <TextBlock
                        Margin="0,15,0,30"
                        FontSize="14"
                        Foreground="#999999"
                        Text="Usa la barra lateral izquierda para buscar y conectarte" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <Button
                            Padding="20,12"
                            Background="#007ACC"
                            Content="🏠 Ir a Home"
                            Click="BtnHome_Click" />

                        <Button
                            Margin="15,0,0,0"
                            Padding="20,12"
                            Background="#007ACC"
                            Content="🔍 Buscar Servidores"
                            Click="BtnServers_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
