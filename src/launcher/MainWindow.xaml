<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GTASALauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GTA San Andreas Multiplayer Launcher"
    Width="1400"
    Height="800"
    Background="#1E1E1E"
    Foreground="#FFFFFF"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">

    <Grid>
        <!-- Left Sidebar Navigation -->
        <StackPanel Width="250" Background="#252526" VerticalAlignment="Stretch">
            <!-- Logo/Title -->
            <TextBlock
                Margin="20,30,20,30"
                FontSize="20"
                FontWeight="Bold"
                Text="SA MULTIPLAYER" />

            <!-- Navigation Buttons -->
            <Button
                x:Name="BtnHome"
                Margin="10,10,10,0"
                Padding="15,10"
                Background="#007ACC"
                Content="🏠 Home"
                Click="BtnHome_Click" />

            <Button
                x:Name="BtnServers"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="🔍 Buscar Servidores"
                Click="BtnServers_Click" />

            <Button
                x:Name="BtnFavorites"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="⭐ Favoritos"
                Click="BtnFavorites_Click" />

            <Button
                x:Name="BtnRecent"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="🕐 Recientes"
                Click="BtnRecent_Click" />

            <!-- Separator -->
            <Separator Margin="10,20,10,20" Background="#3E3E42" />

            <!-- Admin Section -->
            <TextBlock
                Margin="20,10,20,0"
                FontSize="12"
                Foreground="#999999"
                Text="ADMINISTRACIÓN" />

            <Button
                x:Name="BtnCreateServer"
                Margin="10,10,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="➕ Mi Servidor"
                Click="BtnCreateServer_Click" />

            <Button
                x:Name="BtnAdminPanel"
                Margin="10,5,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="⚙️ Panel Admin"
                Click="BtnAdminPanel_Click" />

            <!-- Separator -->
            <Separator Margin="10,20,10,20" Background="#3E3E42" />

            <!-- Settings -->
            <Button
                x:Name="BtnSettings"
                Margin="10,10,10,0"
                Padding="15,10"
                Background="#2D2D30"
                Content="⚙️ Configuración"
                Click="BtnSettings_Click" />

            <!-- Account -->
            <StackPanel
                Margin="10,30,10,0"
                Orientation="Horizontal"
                VerticalAlignment="Bottom">
                <Ellipse
                    Width="40"
                    Height="40"
                    Fill="#007ACC" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding CurrentUser.Username}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="#999999"
                        Text="En línea" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Margin="250,0,0,0">
            <!-- Top Bar -->
            <StackPanel
                Height="60"
                Background="#252526"
                Orientation="Horizontal"
                VerticalAlignment="Top">
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    x:Name="TxtPageTitle"
                    Text="Home" />

                <!-- Search Bar (Right Side) -->
                <StackPanel
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBox
                        Width="300"
                        Padding="10"
                        Background="#3E3E42"
                        Foreground="#FFFFFF"
                        x:Name="TxtSearch"
                        Text=""
                        TextChanged="TxtSearch_TextChanged" />
                    <Button
                        Margin="10,0,0,0"
                        Padding="15,5"
                        Background="#007ACC"
                        Content="🔍 Buscar"
                        Click="BtnSearch_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Content Frame -->
            <Frame
                x:Name="ContentFrame"
                Margin="0,60,0,0"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window>
