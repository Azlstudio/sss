<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GTASALauncher.Pages.AdminPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- Tab Navigation -->
            <TabControl Background="#252526" Foreground="#FFFFFF">
                <!-- Server Settings Tab -->
                <TabItem Header="⚙️ Configuración del Servidor">
                    <StackPanel Margin="20">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="Editar Servidor" />

                        <Separator Margin="0,15" Background="#3E3E42" />

                        <!-- Server Name -->
                        <TextBlock
                            Margin="0,10,0,5"
                            Foreground="#999999"
                            Text="Nombre del Servidor" />
                        <TextBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="Mi Servidor RP" />

                        <!-- Description -->
                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Descripción" />
                        <TextBox
                            Height="100"
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="Servidor de rol play con economia y familias"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch" />

                        <!-- Game Mode -->
                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Modo de Juego" />
                        <ComboBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF">
                            <ComboBoxItem>Role Play</ComboBoxItem>
                            <ComboBoxItem>Team Deathmatch</ComboBoxItem>
                            <ComboBoxItem>Sandbox</ComboBoxItem>
                        </ComboBox>

                        <!-- Banner & Logo -->
                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Banner URL" />
                        <TextBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="https://..." />

                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Logo URL" />
                        <TextBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="https://..." />

                        <!-- Tags -->
                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Tags (separadas por comas)" />
                        <TextBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="RP, Economia, Familias" />

                        <!-- Max Players -->
                        <TextBlock
                            Margin="0,15,0,5"
                            Foreground="#999999"
                            Text="Máximo de Jugadores" />
                        <TextBox
                            Padding="10"
                            Background="#3E3E42"
                            Foreground="#FFFFFF"
                            Text="100" />

                        <!-- Save Button -->
                        <Button
                            Margin="0,20,0,0"
                            Padding="20,12"
                            Background="#007ACC"
                            Content="💾 Guardar Cambios"
                            Click="BtnSaveChanges_Click" />
                    </StackPanel>
                </TabItem>

                <!-- Statistics Tab -->
                <TabItem Header="📊 Estadísticas">
                    <StackPanel Margin="20">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="Estadísticas del Servidor" />

                        <Separator Margin="0,15" Background="#3E3E42" />

                        <!-- Stats Cards -->
                        <Grid ColumnDefinitions="*,*,*,*">
                            <!-- Card 1 -->
                            <Border
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#00FF00"
                                        Text="156" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="#999999"
                                        Text="Visitas Totales" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#FFFF00"
                                        Text="78" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="#999999"
                                        Text="En Línea Ahora" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#FFD700"
                                        Text="4.8" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="#999999"
                                        Text="Rating" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4 -->
                            <Border
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#FF6B6B"
                                        Text="1250" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="#999999"
                                        Text="Votos" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Players Tab -->
                <TabItem Header="👥 Jugadores">
                    <StackPanel Margin="20">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="Jugadores Conectados" />

                        <Separator Margin="0,15" Background="#3E3E42" />

                        <ListBox
                            Height="300"
                            Background="#252526"
                            Foreground="#FFFFFF"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ListBoxItem>Player1 - Nivel 45 - En línea hace 2h</ListBoxItem>
                            <ListBoxItem>Player2 - Nivel 32 - En línea hace 30m</ListBoxItem>
                            <ListBoxItem>Player3 - Nivel 28 - En línea hace 5m</ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
