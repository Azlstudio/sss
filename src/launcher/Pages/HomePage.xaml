<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GTASALauncher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Featured Server Section -->
            <TextBlock
                Margin="30,30,30,15"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Text="🌟 Servidor Destacado" />

            <Border
                Margin="30,0,30,30"
                Background="#252526"
                BorderBrush="#007ACC"
                BorderThickness="2"
                CornerRadius="8">
                <Grid Height="250" Cursor="Hand" MouseDoubleClick="OnFeaturedServerDoubleClick">
                    <!-- Banner Background -->
                    <Rectangle
                        Fill="#1E1E1E"
                        RadiusX="6"
                        RadiusY="6" />

                    <!-- Content -->
                    <StackPanel Margin="20" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <!-- Logo -->
                            <Ellipse
                                Width="80"
                                Height="80"
                                Fill="#007ACC" />

                            <!-- Server Info -->
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Top">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#00FF00"
                                    Text="{Binding FeaturedServer.Name}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="#999999"
                                    Text="{Binding FeaturedServer.Description}" />

                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock Foreground="#888888" Text="Modo: " />
                                    <TextBlock
                                        Foreground="#00FF00"
                                        Text="{Binding FeaturedServer.GameMode}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom Stats -->
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <StackPanel Margin="10,0" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    Text="{Binding FeaturedServer.GetPlayersText}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="#888888"
                                    Text="Jugadores" />
                            </StackPanel>

                            <StackPanel Margin="10,0" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#FFFF00"
                                    Text="{Binding FeaturedServer.PingMs, StringFormat='{0}ms'}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="#888888"
                                    Text="Ping" />
                            </StackPanel>

                            <StackPanel Margin="10,0" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#FFD700"
                                    Text="{Binding FeaturedServer.Rating, StringFormat='{0:F1}'}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="#888888"
                                    Text="Rating" />
                            </StackPanel>

                            <Button
                                Margin="20,0,0,0"
                                Padding="20,10"
                                Background="#007ACC"
                                Content="📱 Conectar"
                                Click="OnConnectClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recommended Servers Section -->
            <TextBlock
                Margin="30,30,30,15"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Text="💡 Recomendados para Ti" />

            <ItemsControl Margin="30,0,30,30" ItemsSource="{Binding RecommendedServers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,15"
                            Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseDoubleClick="OnServerDoubleClick">
                            <Grid Height="120" Padding="15">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Logo -->
                                    <Ellipse
                                        Width="100"
                                        Height="100"
                                        Fill="#007ACC" />

                                    <!-- Info -->
                                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Top">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#FFFFFF"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Foreground="#999999"
                                            Text="{Binding Description}" />

                                        <!-- Tags -->
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,5,0"
                                                            Padding="6,2"
                                                            Background="#007ACC"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="#FFFFFF"
                                                                Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right Stats -->
                                    <StackPanel
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#00FF00"
                                                Text="{Binding GetPlayersText}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="9"
                                                Foreground="#888888"
                                                Text="Jugadores" />
                                        </StackPanel>

                                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#FFFF00"
                                                Text="{Binding PingMs, StringFormat='{0}ms'}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="9"
                                                Foreground="#888888"
                                                Text="Ping" />
                                        </StackPanel>

                                        <Button
                                            Padding="15,8"
                                            Background="#007ACC"
                                            Content="Conectar"
                                            Click="OnConnectClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer -->
            <TextBlock
                Margin="30,40,30,30"
                FontSize="12"
                Foreground="#666666"
                Text="💡 Consejo: Haz doble click en un servidor para conectarte rápidamente" />
        </StackPanel>
    </ScrollViewer>
</Page>
